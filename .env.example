# =========================================================
# LAFD Management Bot - Environment Configuration
# =========================================================
# Copy this file to ".env" and fill in every value below.
# NEVER commit your real ".env" file to GitHub/version control.
# =========================================================

# ---------------------------------------------------------
# CORE BOT CONFIG
# ---------------------------------------------------------
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_client_id_here
GUILD_ID=your_existing_lafd_server_id_here

# ---------------------------------------------------------
# FIRE RANK ROLE IDs (lowest to highest)
# Paste the EXISTING Discord role ID for each rank.
# ---------------------------------------------------------
FIRE_ROLE_PROBATIONARY_FIREFIGHTER=
FIRE_ROLE_FIREFIGHTER_I=
FIRE_ROLE_FIREFIGHTER_II=
FIRE_ROLE_FIREFIGHTER_III=
FIRE_ROLE_ENGINEER=
FIRE_ROLE_SENIOR_ENGINEER=
FIRE_ROLE_JUNIOR_ENGINEER=
FIRE_ROLE_LIEUTENANT=
FIRE_ROLE_CAPTAIN=
FIRE_ROLE_BATTALION_CHIEF=
FIRE_ROLE_HIGH_RANK=
FIRE_ROLE_ASSISTANT_FIRE_CHIEF=
FIRE_ROLE_DEPUTY_FIRE_CHIEF=
FIRE_ROLE_FIRE_CHIEF=

# ---------------------------------------------------------
# EMS RANK ROLE IDs (lowest to highest)
# ---------------------------------------------------------
EMS_ROLE_PROBATIONARY_EMT=
EMS_ROLE_EMT=
EMS_ROLE_JUNIOR_PARAMEDIC=
EMS_ROLE_PARAMEDIC=
EMS_ROLE_PARAMEDIC_IN_CHARGE=
EMS_ROLE_JUNIOR_SUPERVISORY_MEDIC=
EMS_ROLE_SUPERVISORY_MEDIC=
EMS_ROLE_SENIOR_SUPERVISORY_MEDIC=
EMS_ROLE_EMS_SUPERVISORY=
EMS_ROLE_PARAMEDIC_LIEUTENANT=
EMS_ROLE_PARAMEDIC_CAPTAIN=
EMS_ROLE_DIVISION_MEDICAL_OFFICER=
EMS_ROLE_EMS_HIGH_RANK=
EMS_ROLE_EMS_SENIOR_HIGH_RANK=
EMS_ROLE_ASSISTANT_MEDICAL_DIRECTOR=
EMS_ROLE_DEPUTY_MEDICAL_DIRECTOR=
EMS_ROLE_MEDICAL_DIRECTOR=

# ---------------------------------------------------------
# SPECIAL ROLES (NOT part of the rank ladder - never used
# for promotion/demotion logic)
# ---------------------------------------------------------
SPECIAL_ROLE_APPARATUS_OPERATOR=
SPECIAL_ROLE_SUPERVISORY_TEAM=

# ---------------------------------------------------------
# CHANNELS (use EXISTING channels only)
# ---------------------------------------------------------
CHANNEL_CALLSIGN_REQUESTS=
CHANNEL_ANNOUNCEMENTS=

# ---------------------------------------------------------
# LOGGING CHANNELS (use EXISTING channels only)
# If a specific log channel below is left blank, the bot
# will fall back to LOG_CHANNEL_DEFAULT.
# ---------------------------------------------------------
LOG_CHANNEL_DEFAULT=
LOG_CHANNEL_MANAGEMENT=
LOG_CHANNEL_DISCIPLINE=
LOG_CHANNEL_CALLSIGNS=
LOG_CHANNEL_SHIFTS=

# ---------------------------------------------------------
# BRANDING
# ---------------------------------------------------------
# Direct URL to the LAFD department logo image. Used as the
# thumbnail/footer icon across embeds and as guidance for the
# bot's Discord avatar (set the avatar manually in the Discord
# Developer Portal).
LAFD_LOGO_URL=
