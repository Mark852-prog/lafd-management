# =========================================================
# LAFD Management Bot - Environment Configuration
# =========================================================
# Copy this file to ".env" and fill in the CORE values.
# NEVER commit your real ".env" file.
#
# Everything below CORE is OPTIONAL here: every role and
# channel can instead be set from inside Discord with /config
# (values saved with /config override this file).
# =========================================================

# ---------------------------------------------------------
# CORE (required)
# ---------------------------------------------------------
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_client_id_here
GUILD_ID=your_lafd_server_id_here

# Comma-separated user IDs that always have full bot access
# (the server owner always does). Optional.
BOT_OWNER_IDS=

# Slash commands are registered automatically every time the bot starts.
# Set to false only if you manage them yourself with `npm run deploy`.
AUTO_DEPLOY_COMMANDS=true

# ---------------------------------------------------------
# BRANDING (optional)
# ---------------------------------------------------------
LAFD_LOGO_URL=
DEPARTMENT_NAME=Los Angeles Fire Department
DEPARTMENT_SHORT=LAFD

# ---------------------------------------------------------
# POLICY (optional - defaults shown)
# ---------------------------------------------------------
QUOTA_WEEKLY_HOURS=2
SHIFT_MAX_HOURS=12
LEAVE_MAX_DAYS=60
# What happens when a blacklisted user joins: alert | kick | ban
BLACKLIST_ACTION=alert

# ---------------------------------------------------------
# FIRE RANK ROLE IDs (lowest to highest)  - or use /config rank
# ---------------------------------------------------------
FIRE_ROLE_PROBATIONARY_FIREFIGHTER=
FIRE_ROLE_FIREFIGHTER_I=
FIRE_ROLE_FIREFIGHTER_II=
FIRE_ROLE_FIREFIGHTER_III=
FIRE_ROLE_JUNIOR_ENGINEER=
FIRE_ROLE_ENGINEER=
FIRE_ROLE_SENIOR_ENGINEER=
FIRE_ROLE_LIEUTENANT=
FIRE_ROLE_CAPTAIN=
FIRE_ROLE_BATTALION_CHIEF=
FIRE_ROLE_HIGH_RANK=
FIRE_ROLE_ASSISTANT_FIRE_CHIEF=
FIRE_ROLE_DEPUTY_FIRE_CHIEF=
FIRE_ROLE_FIRE_CHIEF=

# ---------------------------------------------------------
# EMS RANK ROLE IDs (lowest to highest)  - or use /config rank
# ---------------------------------------------------------
EMS_ROLE_PROBATIONARY_EMT=
EMS_ROLE_EMT=
EMS_ROLE_JUNIOR_PARAMEDIC=
EMS_ROLE_PARAMEDIC=
EMS_ROLE_PARAMEDIC_IN_CHARGE=
EMS_ROLE_JUNIOR_SUPERVISORY_MEDIC=
EMS_ROLE_SUPERVISORY_MEDIC=
EMS_ROLE_SENIOR_SUPERVISORY_MEDIC=
EMS_ROLE_EMS_SUPERVISORY=
EMS_ROLE_PARAMEDIC_LIEUTENANT=
EMS_ROLE_PARAMEDIC_CAPTAIN=
EMS_ROLE_DIVISION_MEDICAL_OFFICER=
EMS_ROLE_EMS_HIGH_RANK=
EMS_ROLE_EMS_SENIOR_HIGH_RANK=
EMS_ROLE_ASSISTANT_MEDICAL_DIRECTOR=
EMS_ROLE_DEPUTY_MEDICAL_DIRECTOR=
EMS_ROLE_MEDICAL_DIRECTOR=

# ---------------------------------------------------------
# STATUS / DIVISION ROLES  - or /config role, or /config autosetup
# ---------------------------------------------------------
ROLE_LAFD_MEMBER=
ROLE_FIRE_DIVISION=
ROLE_EMS_DIVISION=
ROLE_ON_DUTY=
ROLE_LEAVE_OF_ABSENCE=
ROLE_ADMIN_LEAVE=
ROLE_SUSPENDED=
ROLE_SESSION_PING=
ROLE_TRAINING_PING=
# Grants Company Officer permissions. (SPECIAL_ROLE_SUPERVISORY_TEAM still works.)
ROLE_SUPERVISORY_TEAM=

# ---------------------------------------------------------
# CERTIFICATION ROLES (optional - granted with the certification)
# ---------------------------------------------------------
# (SPECIAL_ROLE_APPARATUS_OPERATOR still works.)
CERT_ROLE_APPARATUS_OPERATOR=
CERT_ROLE_EMT_BASIC=
CERT_ROLE_ADVANCED_LIFE_SUPPORT=
CERT_ROLE_HAZMAT=
CERT_ROLE_TECHNICAL_RESCUE=
CERT_ROLE_WILDLAND=
CERT_ROLE_AIR_OPERATIONS=
CERT_ROLE_FIELD_TRAINING_OFFICER=

# ---------------------------------------------------------
# CHANNELS  - or /config channel, or /config autosetup
# ---------------------------------------------------------
CHANNEL_ANNOUNCEMENTS=
CHANNEL_PROMOTIONS=
CHANNEL_COMMENDATIONS=
CHANNEL_SESSIONS=
CHANNEL_TRAINING=
CHANNEL_INCIDENT_REPORTS=
CHANNEL_CALLSIGN_REQUESTS=
CHANNEL_LEAVE_REQUESTS=

# ---------------------------------------------------------
# LOG CHANNELS - any left blank fall back to LOG_CHANNEL_DEFAULT
# ---------------------------------------------------------
LOG_CHANNEL_DEFAULT=
LOG_CHANNEL_MANAGEMENT=
LOG_CHANNEL_DISCIPLINE=
LOG_CHANNEL_CALLSIGNS=
LOG_CHANNEL_SHIFTS=
LOG_CHANNEL_PERSONNEL=
LOG_CHANNEL_OPERATIONS=
